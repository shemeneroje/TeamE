<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.savourit.feature.payments.PaymentViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color"
        tools:context=".feature.profile.ProfileActivity">

        <!-- Curved Background -->
        <ImageView
            android:id="@+id/curved_top"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/top_background_shape"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Premium Version Box with Title and Features -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/premium_version_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/curved_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center"
                android:background="@android:color/white">

                <!-- Premium Version Title -->
                <TextView
                    android:id="@+id/premium_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium Version"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center" />

                <!-- Premium Version Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receive all of the Plus features!\n\nReceive recommendations based on what you and your friends have liked!\n\nReceive discount codes for your favourite restaurants!"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Back Button (positioned directly below the Premium Version Box) -->
        <LinearLayout
            android:id="@+id/back_button_container"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:background="@drawable/gradient_button"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/premium_version_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Payment Button (positioned below the Back Button) -->
        <LinearLayout
            android:id="@+id/payment_button_container"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:background="@drawable/gradient_button"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/back_button_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go to Payment"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
