<?xml version="1.0" encoding="utf-8"?>

    <!-- Main content layout -->
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <!-- Content Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Places Autocomplete Fragment for Location Search -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/autocomplete_fragment"
                android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_toStartOf="@id/filterIcon"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/custom_edittext" />

            <!-- Filter Icon -->
            <ImageView
                android:id="@+id/filterIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:padding="10dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_filter"
                android:layout_alignTop="@id/autocomplete_fragment"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/autocomplete_fragment"
                android:contentDescription="@string/filter_icon"/>

            <!-- Google Map Fragment -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/autocomplete_fragment"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnStopNavigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop Navigation"
                android:visibility="gone"
                android:background="@color/red"
                android:textColor="@color/white"/>


        </RelativeLayout>
    </LinearLayout>
