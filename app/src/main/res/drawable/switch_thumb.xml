<!-- res/drawable/switch_thumb.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/your_checked_thumb_color" /> <!-- Change to your desired color -->
            <size android:width="24dp" android:height="24dp" /> <!-- Adjust size as needed -->
        </shape>
    </item>
    <!-- Unchecked state -->
    <item android:state_checked="false">
        <shape android:shape="oval">
            <solid android:color="@color/your_unchecked_thumb_color" /> <!-- Change to your desired color -->
            <size android:width="24dp" android:height="24dp" /> <!-- Adjust size as needed -->
        </shape>
    </item>
</selector>