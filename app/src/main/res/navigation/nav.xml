<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.savourit.feature.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            app:destination="@id/nav_friends"
            android:id="@+id/home_to_friends"/>
    </fragment>
    <fragment
        android:id="@+id/nav_friends"
        android:name="com.example.savourit.feature.friends.FriendsFragment"
        android:label="Friends"
        tools:layout="@layout/fragment_friends" >
        <action
            app:destination="@+id/nav_friends_detail"
            android:id="@+id/friends_to_friends_detail"
            />
        <action
            app:destination="@+id/nav_chat"
            android:id="@+id/friends_to_chat"
            />
    </fragment>

    <fragment
        android:id="@+id/nav_friends_detail"
        android:name="com.example.savourit.feature.friends.FriendDetailsFragment"
        android:label="Friends"
        tools:layout="@layout/fragment_friend_details" >
    </fragment>

    <fragment
        android:id="@+id/nav_chat"
        android:name="com.example.savourit.feature.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat" >
        <argument
            android:name="friendId"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.savourit.feature.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/fragment_profile"
        android:name="com.example.savourit.feature.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>
